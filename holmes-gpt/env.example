# Anthropic API — copy to .env: cp env.example .env
ANTHROPIC_API_KEY=your-anthropic-api-key-here

ANTHROPIC_MODEL=claude-haiku-4-5

# Cost controls (see README or docs; all optional)
ANTHROPIC_MAX_TOKENS=700
ANTHROPIC_COMPACT_PROMPT=true
ANTHROPIC_PROMPT_CACHE=true
ANTHROPIC_MAX_QUOTES=1

# SQLite database directory (default: ./data)
DB_DIR=./data

# Admin dashboard login (required for /admin in production)
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional bearer token for /api/security (defaults to ADMIN_PASSWORD)
SECURITY_TOKEN=

# Behind a reverse proxy (Traefik, nginx, Cloudflare…) set these so rate limiting
# sees the real visitor IP and cookies get the right scheme. Use the header your
# proxy sets, with XFF_DEPTH = number of trusted proxies in front of the app.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
